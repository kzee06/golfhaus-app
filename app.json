{
  "expo": {
    "name": "GolfHaus",
    "slug": "golfhaus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.golfhaus.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GolfHaus uses your location to show GPS distances to the green and find courses near you."
      }
    },
    "android": {
      "package": "com.golfhaus.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-updates",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GolfHaus uses your location to show GPS distances to the green and find courses near you."
        }
      ]
    ],
    "scheme": "golfhaus"
  }
}
